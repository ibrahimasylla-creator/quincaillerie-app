# Copier ce fichier en .env et adapter les valeurs avant le premier lancement
MYSQL_ROOT_PASSWORD=root_pwd_change_me
DB_USER=quincaillerie
DB_PASSWORD=quincaillerie_pwd

# IMPORTANT : doit etre une longue chaine aleatoire en production.
# Cette meme valeur est utilisee par la Gateway (pour verifier les tokens)
# et par le service Auth (pour les signer) : ils doivent etre identiques.
JWT_SHARED_SECRET=shared-jwt-secret-change-in-prod

DJANGO_SECRET_KEY=dev-secret-change-in-prod
DEBUG=1
